{
  "name": "vue2-widget-lib",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "vue-cli-service build",
    "build:all": "rm -rf dist && npm run build:sales && npm run build:chart && npm run build:filter && npm run build:orders",
    "build:sales": "WIDGET_NAME=bi-sales-panel vue-cli-service build --no-clean",
    "build:chart": "WIDGET_NAME=bi-chart-panel vue-cli-service build --no-clean",
    "build:filter": "WIDGET_NAME=bi-filter-bar vue-cli-service build --no-clean",
    "build:orders": "WIDGET_NAME=bi-orders-panel vue-cli-service build --no-clean",
    "serve": "vue-cli-service serve",
    "serve:widget": "WIDGET_BUILD=true vue-cli-service build --watch --mode development",
    "serve:dist": "npx serve dist -l 8081 --cors"
  },
  "dependencies": {
    "vue": "^2.6.14"
  },
  "devDependencies": {
    "@vue/cli-plugin-babel": "~5.0.8",
    "@vue/cli-service": "~5.0.8",
    "@vue/web-component-wrapper": "^1.3.0",
    "vue-template-compiler": "^2.6.14"
  }
}
