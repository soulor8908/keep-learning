{
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@vue/compiler-sfc": "^3.5.39",
    "acorn": "^8.17.0",
    "acorn-walk": "^8.3.5",
    "concurrently": "^10.0.3",
    "cross-env": "^7.0.3",
    "happy-dom": "^14.0.0",
    "jsdoc": "^4.0.5",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "vitest": "^1.6.0"
  },
  "scripts": {
    "build:widgets": "cd demo/vue2-widgets && pnpm run build && cd ../vue3-widgets && pnpm run build && cd ../h5-widgets && pnpm run build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ci": "vitest run --reporter=verbose",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "e2e:report": "playwright show-report",
    "docs:api": "jsdoc -c jsdoc.conf.json",
    "docs:api:serve": "jsdoc -c jsdoc.conf.json && npx http-server docs/api -p 4000"
  }
}
